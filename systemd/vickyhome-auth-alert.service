[Unit]
Description=Real-time SSH & sudo Phone Alert Monitor (ntfy/Telegram)
After=network-online.target rsyslog.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/bin/vickyhome-auth-alert.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
