[Unit]
Description=vickyhome Monitoring & Security Telegram Bot (Hardened)
After=network-online.target AdGuardHome.service
Wants=network-online.target

[Service]
Type=simple
User=vickybot
Group=vickybot
SupplementaryGroups=video
ExecStart=/usr/bin/python3 -B -u /usr/local/bin/vickyhome-telegram-bot.py
Restart=always
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/video0 rw
DeviceAllow=/dev/video1 rw
DeviceAllow=/dev/video2 rw
DeviceAllow=/dev/video3 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/vickyhome-tgbot.conf
ReadWritePaths=/var/lib/vickyhome-tgbot

[Install]
WantedBy=multi-user.target
